GCC_TREAT_INCOMPATIBLE_POINTER_TYPE_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
MTL_TREAT_WARNINGS_AS_ERRORS = YES
OTHER_SWIFT_FLAGS = $(inherited) -warnings-as-errors

// BConnected product version (MAJOR.MINOR.PATCH) and monotonic distribution build.
// The app and both extensions share these values.
CURRENT_PROJECT_VERSION = 6
MARKETING_VERSION = 0.2.0

// Upstream lineage and compatibility version; independent of product releases.
BCONNECTED_SIGNAL_BASE_VERSION = 8.30.0

// User-specific overrides
#include? "User.xcconfig"
